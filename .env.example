OPENAI_API_KEY=
# Optional: switch the model (see everymd/models.py). Default: openai:gpt-6-luna
# EVERYMD_MODEL=anthropic:<model>
# ANTHROPIC_API_KEY=
# EVERYMD_BASE_URL=http://host.docker.internal:8000/v1
# EVERYMD_API_KEY=
# EVERYMD_MODEL_SEES_IMAGES=true
# GOOGLE_API_KEY=

# Optional: reasoning effort (production default medium; tests use low)
# EVERYMD_REASONING_EFFORT=low

# Optional: token for the Jupyter server (docker compose up -d jupyter)
# JUPYTER_TOKEN=everymd
